// Forum runner template (workflow-context orchestration).
// Skinny emitter stamps:
//   META             — let meta = #{ name, description, phases… };
//   WORKFLOW_JSON    — workspace-relative path to workflow.json
//   TOOLBOX_SCRIPT   — path to tools/toolbox/rhaiteous-toolbox.mjs
//
// Prompt per station = Operational Guidance (common) + Input + Station Instructions
// (concatenated here; station agents do not read_file those prompts themselves).
// Persistence via Rhaiteous toolbox under <out_dir>/threads/.

@@META@@

let default_workflow_json = @@WORKFLOW_JSON@@;
let toolbox_script = @@TOOLBOX_SCRIPT@@;

if args == () {
    pause("verification", "Pass args: at least station_dir (and workflow path if not using compile-time default).");
}

let workflow_path = args.workflow;
if workflow_path == () || workflow_path == "" {
    workflow_path = default_workflow_json;
}
if workflow_path == () || workflow_path == "" {
    pause("verification", "Pass args.workflow — path to workflow.json (or compile with a known workflow.json path).");
}

let context_only = args.context_only == true;

// Optional launch override; Init fills from workflow.args.out_dir when omitted.
let out_dir = args.out_dir;
if out_dir == () {
    out_dir = "";
}

fn toolbox_cmd(script, out_directory) {
    "node " + script + " --threads-root " + out_directory + "/threads"
}

let init_schema = #{
    "type": "object",
    "required": ["ok", "context_id", "stations", "prompts", "out_dir", "path"],
    "properties": #{
        "ok": #{ "type": "boolean" },
        "context_id": #{ "type": "string" },
        "path": #{ "type": "string" },
        "error": #{ "type": "string" },
        "stations": #{ "type": "array", "items": #{ "type": "string" } },
        "caps": #{ "type": "object" },
        "station_dir": #{ "type": "string" },
        "out_dir": #{ "type": "string" },
        "prompts": #{ "type": "object" },
        "prompt_keys": #{ "type": "array", "items": #{ "type": "string" } },
        "finalizer": #{ "type": "string" },
        "pack_dir": #{ "type": "string" },
        "default_routes": #{ "type": "object" },
    },
};

let finalize_schema = #{
    "type": "object",
    "required": ["ok"],
    "properties": #{
        "ok": #{ "type": "boolean" },
        "exit_code": #{ "type": "integer" },
        "stdout": #{ "type": "string" },
        "stderr": #{ "type": "string" },
        "error": #{ "type": "string" },
        "skipped": #{ "type": "boolean" },
    },
};

let post_schema = #{
    "type": "object",
    "required": ["metadata", "message"],
    "properties": #{
        "metadata": #{
            "type": "object",
            "required": ["from"],
            "properties": #{
                "from": #{ "type": "string" },
                "to": #{},
                "visit": #{ "type": "integer" },
                "mode": #{ "type": "string" },
                "routing_rationale": #{ "type": "string" },
                "rationale_history": #{ "type": "array" },
            },
        },
        "message": #{
            "type": "object",
            "properties": #{
                "mime": #{ "type": "string" },
                "body": #{ "type": "string" },
                "attachments": #{ "type": "array" },
            },
        },
    },
};

fn normalize_to(raw) {
    if raw == () { return (); }
    if type_of(raw) == "array" {
        if raw.len() == 0 { return (); }
        return raw[0];
    }
    if type_of(raw) == "string" && raw == "" { return (); }
    raw
}

// Explicit terminal: empty array or empty string (not omitted / ())
fn is_explicit_terminal(raw) {
    if raw == () { return false; }
    if type_of(raw) == "array" && raw.len() == 0 { return true; }
    if type_of(raw) == "string" && raw == "" { return true; }
    false
}

// Use metadata.to when set; []/"" end the run; omitted → stations[].default_route
fn resolve_next(raw_to, from_name, default_routes) {
    let n = normalize_to(raw_to);
    if n != () { return n; }
    if is_explicit_terminal(raw_to) { return (); }
    if default_routes == () || from_name == () || from_name == "" { return (); }
    let d = default_routes[from_name];
    if d == () || d == "" { return (); }
    d
}

fn build_input_section(station_name, context_id, toolbox_prefix, wf_path, out_directory) {
    let s = "";
    s += "## Input\n\n";
    s += "The **input** for your performance consists of the following:\n\n";
    s += "- this station's name: `" + station_name + "`\n";
    s += "- workflow-context id: `" + context_id + "`\n";
    s += "- Rhaiteous toolbox invocation prefix: `" + toolbox_prefix + "`\n";
    s += "- workflow definition path: `" + wf_path + "` (read when station instructions require run settings / args)\n";
    s += "- out_dir: `" + out_directory + "` (workflow context files are under `" + out_directory + "/threads/`)\n";
    s
}

fn build_station_prompt(guidance, station_name, station_instructions, context_id, toolbox_prefix, wf_path, out_directory) {
    let s = "";
    s += guidance;
    s += "\n\n";
    s += build_input_section(station_name, context_id, toolbox_prefix, wf_path, out_directory);
    s += "\n";
    s += "## Station Instructions\n\n";
    s += station_instructions;
    s += "\n";
    s
}

phase("Init");

let init_prompt = "";
init_prompt += "Setup only — you are not a workflow station.\n\n";
init_prompt += "1) read_file exactly: " + workflow_path + "\n";
init_prompt += "   Parse stations[].name and max_visits (default 1) → stations[], caps{}.\n";
init_prompt += "   Build default_routes{}: for each station with a non-empty string default_route, map station name → that route (must be another station name).\n";
init_prompt += "   Resolve station_dir: launch args.station_dir if set, else workflow.args.station_dir.\n";
init_prompt += "   Resolve out_dir: launch args.out_dir if set, else workflow.args.out_dir. Required — fail if missing/empty.\n";
init_prompt += "   Parse schemas map; read each schema file under station_dir; build schemas{} objects.\n";
init_prompt += "   Parse prompts map (binding → filename under station_dir).\n";
init_prompt += "   Optional top-level finalizer: if workflow.finalizer is a non-empty string, resolve it relative to the directory containing workflow.json (pack_dir). If that file does not exist, treat as unset. If missing, empty, null, or false → finalizer=\"\".\n";
init_prompt += "2) Create workflow context under out_dir/threads (do not write thread.json by hand):\n";
init_prompt += "   Pipe {\"stations\":[...],\"caps\":{...},\"schemas\":{...}} to:\n";
init_prompt += "   node " + toolbox_script + " --threads-root <out_dir>/threads thread-create\n";
init_prompt += "   (replace <out_dir> with the resolved out_dir; create parent dirs as needed via the tool).\n";
init_prompt += "   Parse stdout for id → context_id and path (path = thread.json for this run).\n";
init_prompt += "3) read_file prompt files as UTF-8 text:\n";
init_prompt += "   - prompts.common = body of the common / thread_common prompt file\n";
init_prompt += "   - For each station name S, prompts[S] = body of that station's prompt file\n";
init_prompt += "     (resolve via workflow.prompts + stations[].prompt bindings; prefer the last non-common binding).\n";
init_prompt += "4) If args.context_only would apply, still return prompts and stations (orchestrator may short-circuit).\n";
init_prompt += "5) Return ok=true, context_id, path (thread.json), pack_dir, finalizer (resolved script path or \"\"), default_routes{}, stations, caps, station_dir, out_dir, prompts{ common, <StationName>: ... }, prompt_keys.\n";
init_prompt += "   On failure ok=false and error.\n";

let init_r = agent(init_prompt, #{
    label: "init:context-and-prompts",
    capability_mode: "all",
    output_schema: init_schema,
});

if init_r == () || !init_r.success || init_r.output == () || init_r.output.ok != true {
    let msg = "Init failed";
    if init_r != () && init_r.output != () && init_r.output.error != () {
        msg = init_r.output.error;
    }
    pause("infra", msg);
}

let context_id = init_r.output.context_id;
let stations = init_r.output.stations;
let prompts = init_r.output.prompts;
let station_dir = init_r.output.station_dir;
let default_routes = init_r.output.default_routes;
if default_routes == () {
    default_routes = #{};
}
out_dir = init_r.output.out_dir;

if stations == () || type_of(stations) != "array" || stations.len() == 0 {
    pause("infra", "Init returned no stations");
}
if prompts == () || prompts.common == () || prompts.common == "" {
    pause("infra", "Init returned empty prompts.common (Operational Guidance)");
}
if out_dir == () || out_dir == "" {
    pause("infra", "Init returned empty out_dir (workflow context must live under out_dir/threads)");
}

let toolbox = toolbox_cmd(toolbox_script, out_dir);

if context_only {
    complete(#{
        mode: "context_only",
        context_id: context_id,
        stations: stations,
        caps: init_r.output.caps,
        station_dir: station_dir,
        out_dir: out_dir,
        workflow_path: workflow_path,
        prompt_keys: init_r.output.prompt_keys,
    });
}

let guidance = prompts.common;
let next_name = stations[0];
let guard = 0;
let last_post = ();

while next_name != () {
    guard += 1;
    if guard > 128 {
        complete(#{ ok: false, step: "loop-guard", context_id: context_id, last_post: last_post });
    }

    let station_name = next_name;
    phase(station_name);

    let station_instructions = prompts[station_name];
    if station_instructions == () || station_instructions == "" {
        complete(#{
            ok: false,
            step: "missing-station-instructions",
            station: station_name,
            context_id: context_id,
        });
    }

    let prompt = build_station_prompt(
        guidance,
        station_name,
        station_instructions,
        context_id,
        toolbox,
        workflow_path,
        out_dir
    );

    let sr = agent(prompt, #{
        label: "station:" + station_name,
        capability_mode: "all",
        output_schema: post_schema,
    });

    if sr == () || !sr.success || sr.output == () {
        complete(#{
            ok: false,
            step: "station",
            station: station_name,
            result: sr,
            context_id: context_id,
        });
    }

    last_post = sr.output;
    let raw_to = last_post.metadata["to"];
    let from_name = last_post.metadata["from"];
    if from_name == () || from_name == "" {
        from_name = station_name;
    }
    next_name = resolve_next(raw_to, from_name, default_routes);
}

// Optional pack finalizer (workflow.finalizer → node <script> <thread.json>)
let finalizer = init_r.output.finalizer;
if finalizer == () {
    finalizer = "";
}
let thread_path = init_r.output.path;
let finalize_skipped = true;
let finalize_ok = true;
let finalize_detail = ();

if finalizer != "" && thread_path != () && thread_path != "" {
    phase("Finalize");
    finalize_skipped = false;
    let fin_prompt = "";
    fin_prompt += "You are not a workflow station. Run the pack finalizer exactly once.\n\n";
    fin_prompt += "Execute this shell command (quote paths if they contain spaces):\n\n";
    fin_prompt += "node " + finalizer + " " + thread_path + "\n\n";
    fin_prompt += "Do not invent another command. Capture exit code, stdout, and stderr.\n";
    fin_prompt += "Return ok=true only if exit code is 0; otherwise ok=false with error summarizing stderr/stdout.\n";

    let fr = agent(fin_prompt, #{
        label: "finalize:pack-script",
        capability_mode: "all",
        output_schema: finalize_schema,
    });

    if fr == () || !fr.success || fr.output == () || fr.output.ok != true {
        finalize_ok = false;
        let msg = "Finalize failed";
        if fr != () && fr.output != () && fr.output.error != () {
            msg = fr.output.error;
        }
        complete(#{
            ok: false,
            step: "finalize",
            error: msg,
            context_id: context_id,
            last_post: last_post,
            workflow_path: workflow_path,
            station_dir: station_dir,
            out_dir: out_dir,
            finalizer: finalizer,
            thread_path: thread_path,
            finalize: fr,
        });
    }

    finalize_detail = fr.output;
}

complete(#{
    ok: true,
    context_id: context_id,
    last_post: last_post,
    workflow_path: workflow_path,
    station_dir: station_dir,
    out_dir: out_dir,
    finalizer: finalizer,
    thread_path: thread_path,
    finalize_skipped: finalize_skipped,
    finalize: finalize_detail,
});
