};
let control = #{
    stations: [
  "Intake",
  "Formulation",
  "Validation",
  "Presentation",
  "QA",
],
    caps: #{
  Formulation: 12,
  Intake: 1,
  Presentation: 1,
  QA: 1,
  Validation: 12,
},
    station_run: #{},
    token_total: 0,
    elapsed_total: 0,
    tokens: [],
    elapsed: [],
    current: (),
    next: (),
    warnings: [],
};


// Args JSON for station prompts
let workflow_args_map = #{};

workflow_args_map.curated = curated;

workflow_args_map.flow_json_name = flow_json_name;

workflow_args_map.issues_md_name = issues_md_name;

workflow_args_map.out_dir = out_dir;

workflow_args_map.report_title = report_title;

workflow_args_map.source_candidates = source_candidates;

let workflow_args_json = json_encode(workflow_args_map);


let next_name = control.stations[0];
control.next = next_name;

while next_name != () {
    let extra = "";

    if next_name == "Intake" {
        phase("Intake");
        control.current = "Intake";
        control = begin_station_visit(control, "Intake");
        let visit_n = control.station_run["Intake"];
        let budget = budget_block(control);
        let extra = "";
        extra += "\n===== [common.md] =====\n## Shared rules (forum / thread + posts)\n\nYou do **not** return a full flow/payload envelope.\n\nReturn **exactly one post**:\n\n```json\n{\n  \"metadata\": {\n    \"from\": \"<your station name>\",\n    \"to\": \"<NextStationName>\",\n    \"visit\": 1,\n    \"routing_rationale\": \"<one line when caps or non-default routing apply>\"\n  },\n  \"message\": {\n    \"mime\": \"text/markdown\",\n    \"body\": \"<optional markdown>\",\n    \"attachments\": [\n      {\n        \"name\": \"result\",\n        \"mime\": \"application/json\",\n        \"schema\": \"<key from workflow schemas map>\",\n        \"content\": { }\n      }\n    ]\n  }\n}\n```\n\n### Routing\n- Set **`metadata.to`** to a single station name (string). Multi-recipient is unsupported.\n- Default: next station in the workflow station list after yours; last station uses `\"to\": []`.\n- **`metadata.from`** must be your station name (the driver also stamps it).\n\n### Caps / budget\nA budget block may list remaining visits (and optional token/elapsed totals).\nIf your preferred `metadata.to` has remaining 0, do not route there. Follow station-specific fail vs accept-partial rules and set `metadata.routing_rationale`.\n\n### MIME\nUse property name **`mime`** everywhere (message body and attachments), e.g. `text/markdown`, `text/plain`, `application/json`.\n\n### Args\nHonor **Workflow args (JSON)**. Do not invent paths or titles.\n\n===== [intake.md] =====\n## Intake\n\nVerify args.source_candidates. Build curated Markdown (path in args.curated or under out_dir).\nEmit post schema `intake` describing verified sources + curated path.\nAlso attach curated content or path reference.\nSet `metadata.to` to \"Formulation\".\n";
        extra += "\n\n## Visit / budget (authoritative)\n";
        extra += budget;
        extra += "\n\n## Your station\nName: " + "Intake" + "\nVisit: " + visit_n + "\n";
        extra += "\nReturn exactly one post: metadata (from, to, visit, routing_rationale) + message (mime, body, attachments). Use mime everywhere (e.g. text/markdown, application/json). Set metadata.routing_rationale when routing is non-default or caps force a choice.\n";
        extra += "\n\n## Workflow args (JSON)\n";
        extra += workflow_args_json;
        extra += "\n\n## Attachment schema keys for this station\n";
        extra += "- " + "intake" + " (see thread.schemas)\n";
        let output = agent(
            "Station " + "Intake" + "\n\n" + extra,
            #{
                label: "Intake",
                capability_mode: "read-write",
                output_schema: make_post_schema(),
            }
        );
        let applied = apply_station_result(conversation, control, "Intake", visit_n, output);
        conversation = applied.conversation;
        control = applied.control;
    } else if next_name == "Formulation" {
        phase("Formulation");
        control.current = "Formulation";
        control = begin_station_visit(control, "Formulation");
        let visit_n = control.station_run["Formulation"];
        let budget = budget_block(control);
        let extra = "";
        extra += "\n===== [common.md] =====\n## Shared rules (forum / thread + posts)\n\nYou do **not** return a full flow/payload envelope.\n\nReturn **exactly one post**:\n\n```json\n{\n  \"metadata\": {\n    \"from\": \"<your station name>\",\n    \"to\": \"<NextStationName>\",\n    \"visit\": 1,\n    \"routing_rationale\": \"<one line when caps or non-default routing apply>\"\n  },\n  \"message\": {\n    \"mime\": \"text/markdown\",\n    \"body\": \"<optional markdown>\",\n    \"attachments\": [\n      {\n        \"name\": \"result\",\n        \"mime\": \"application/json\",\n        \"schema\": \"<key from workflow schemas map>\",\n        \"content\": { }\n      }\n    ]\n  }\n}\n```\n\n### Routing\n- Set **`metadata.to`** to a single station name (string). Multi-recipient is unsupported.\n- Default: next station in the workflow station list after yours; last station uses `\"to\": []`.\n- **`metadata.from`** must be your station name (the driver also stamps it).\n\n### Caps / budget\nA budget block may list remaining visits (and optional token/elapsed totals).\nIf your preferred `metadata.to` has remaining 0, do not route there. Follow station-specific fail vs accept-partial rules and set `metadata.routing_rationale`.\n\n### MIME\nUse property name **`mime`** everywhere (message body and attachments), e.g. `text/markdown`, `text/plain`, `application/json`.\n\n### Args\nHonor **Workflow args (JSON)**. Do not invent paths or titles.\n\n===== [formulation.md] =====\n## Formulation\n\nmax_visits=12. Read **only** curated corpus from the thread (not raw sources).\nEmit issues attachment schema `formulation` including itemsAdded.\nIf Validation asked for rework, address that in message body/attachments.\nDefault `metadata.to` \"Validation\". Set `metadata.routing_rationale` when looping.\n";
        extra += "\n\n## Visit / budget (authoritative)\n";
        extra += budget;
        extra += "\n\n## Your station\nName: " + "Formulation" + "\nVisit: " + visit_n + "\n";
        extra += "\nReturn exactly one post: metadata (from, to, visit, routing_rationale) + message (mime, body, attachments). Use mime everywhere (e.g. text/markdown, application/json). Set metadata.routing_rationale when routing is non-default or caps force a choice.\n";
        extra += "\n\n## Workflow args (JSON)\n";
        extra += workflow_args_json;
        extra += "\n\n## Attachment schema keys for this station\n";
        extra += "- " + "formulation" + " (see thread.schemas)\n";
        let output = agent(
            "Station " + "Formulation" + "\n\n" + extra,
            #{
                label: "Formulation",
                capability_mode: "read-only",
                output_schema: make_post_schema(),
            }
        );
        let applied = apply_station_result(conversation, control, "Formulation", visit_n, output);
        conversation = applied.conversation;
        control = applied.control;
    } else if next_name == "Validation" {
        phase("Validation");
        control.current = "Validation";
        control = begin_station_visit(control, "Validation");
        let visit_n = control.station_run["Validation"];
        let budget = budget_block(control);
        let extra = "";
        extra += "\n===== [common.md] =====\n## Shared rules (forum / thread + posts)\n\nYou do **not** return a full flow/payload envelope.\n\nReturn **exactly one post**:\n\n```json\n{\n  \"metadata\": {\n    \"from\": \"<your station name>\",\n    \"to\": \"<NextStationName>\",\n    \"visit\": 1,\n    \"routing_rationale\": \"<one line when caps or non-default routing apply>\"\n  },\n  \"message\": {\n    \"mime\": \"text/markdown\",\n    \"body\": \"<optional markdown>\",\n    \"attachments\": [\n      {\n        \"name\": \"result\",\n        \"mime\": \"application/json\",\n        \"schema\": \"<key from workflow schemas map>\",\n        \"content\": { }\n      }\n    ]\n  }\n}\n```\n\n### Routing\n- Set **`metadata.to`** to a single station name (string). Multi-recipient is unsupported.\n- Default: next station in the workflow station list after yours; last station uses `\"to\": []`.\n- **`metadata.from`** must be your station name (the driver also stamps it).\n\n### Caps / budget\nA budget block may list remaining visits (and optional token/elapsed totals).\nIf your preferred `metadata.to` has remaining 0, do not route there. Follow station-specific fail vs accept-partial rules and set `metadata.routing_rationale`.\n\n### MIME\nUse property name **`mime`** everywhere (message body and attachments), e.g. `text/markdown`, `text/plain`, `application/json`.\n\n### Args\nHonor **Workflow args (JSON)**. Do not invent paths or titles.\n\n===== [validation.md] =====\n## Validation\n\nmax_visits=12. If Formulation.itemsAdded != 0, set `metadata.to` to \"Formulation\" with `metadata.routing_rationale` (coverage incomplete).\nIf Formulation remaining visits is 0 and coverage still incomplete: choose **fail** or **accept partial** per project policy; set `metadata.routing_rationale`; route to Presentation if accepting.\nWhen itemsAdded==0, validate items; then set `metadata.to` to \"Presentation\".\nSchema `validation`.\n";
        extra += "\n\n## Visit / budget (authoritative)\n";
        extra += budget;
        extra += "\n\n## Your station\nName: " + "Validation" + "\nVisit: " + visit_n + "\n";
        extra += "\nReturn exactly one post: metadata (from, to, visit, routing_rationale) + message (mime, body, attachments). Use mime everywhere (e.g. text/markdown, application/json). Set metadata.routing_rationale when routing is non-default or caps force a choice.\n";
        extra += "\n\n## Workflow args (JSON)\n";
        extra += workflow_args_json;
        extra += "\n\n## Attachment schema keys for this station\n";
        extra += "- " + "validation" + " (see thread.schemas)\n";
        let output = agent(
            "Station " + "Validation" + "\n\n" + extra,
            #{
                label: "Validation",
                capability_mode: "read-only",
                output_schema: make_post_schema(),
            }
        );
        let applied = apply_station_result(conversation, control, "Validation", visit_n, output);
        conversation = applied.conversation;
        control = applied.control;
    } else if next_name == "Presentation" {
        phase("Presentation");
        control.current = "Presentation";
        control = begin_station_visit(control, "Presentation");
        let visit_n = control.station_run["Presentation"];
        let budget = budget_block(control);
        let extra = "";
        extra += "\n===== [common.md] =====\n## Shared rules (forum / thread + posts)\n\nYou do **not** return a full flow/payload envelope.\n\nReturn **exactly one post**:\n\n```json\n{\n  \"metadata\": {\n    \"from\": \"<your station name>\",\n    \"to\": \"<NextStationName>\",\n    \"visit\": 1,\n    \"routing_rationale\": \"<one line when caps or non-default routing apply>\"\n  },\n  \"message\": {\n    \"mime\": \"text/markdown\",\n    \"body\": \"<optional markdown>\",\n    \"attachments\": [\n      {\n        \"name\": \"result\",\n        \"mime\": \"application/json\",\n        \"schema\": \"<key from workflow schemas map>\",\n        \"content\": { }\n      }\n    ]\n  }\n}\n```\n\n### Routing\n- Set **`metadata.to`** to a single station name (string). Multi-recipient is unsupported.\n- Default: next station in the workflow station list after yours; last station uses `\"to\": []`.\n- **`metadata.from`** must be your station name (the driver also stamps it).\n\n### Caps / budget\nA budget block may list remaining visits (and optional token/elapsed totals).\nIf your preferred `metadata.to` has remaining 0, do not route there. Follow station-specific fail vs accept-partial rules and set `metadata.routing_rationale`.\n\n### MIME\nUse property name **`mime`** everywhere (message body and attachments), e.g. `text/markdown`, `text/plain`, `application/json`.\n\n### Args\nHonor **Workflow args (JSON)**. Do not invent paths or titles.\n\n===== [presentation.md] =====\n## Presentation\n\nWrite thread JSON + issues markdown under args.out_dir.\nSchema `presentation`.\nSet `metadata.to` to \"QA\".\n";
        extra += "\n\n## Visit / budget (authoritative)\n";
        extra += budget;
        extra += "\n\n## Your station\nName: " + "Presentation" + "\nVisit: " + visit_n + "\n";
        extra += "\nReturn exactly one post: metadata (from, to, visit, routing_rationale) + message (mime, body, attachments). Use mime everywhere (e.g. text/markdown, application/json). Set metadata.routing_rationale when routing is non-default or caps force a choice.\n";
        extra += "\n\n## Workflow args (JSON)\n";
        extra += workflow_args_json;
        extra += "\n\n## Attachment schema keys for this station\n";
        extra += "- " + "presentation" + " (see thread.schemas)\n";
        let output = agent(
            "Station " + "Presentation" + "\n\n" + extra,
            #{
                label: "Presentation",
                capability_mode: "read-write",
                output_schema: make_post_schema(),
            }
        );
        let applied = apply_station_result(conversation, control, "Presentation", visit_n, output);
        conversation = applied.conversation;
        control = applied.control;
    } else if next_name == "QA" {
        phase("QA");
        control.current = "QA";
        control = begin_station_visit(control, "QA");
        let visit_n = control.station_run["QA"];
        let budget = budget_block(control);
        let extra = "";
        extra += "\n===== [common.md] =====\n## Shared rules (forum / thread + posts)\n\nYou do **not** return a full flow/payload envelope.\n\nReturn **exactly one post**:\n\n```json\n{\n  \"metadata\": {\n    \"from\": \"<your station name>\",\n    \"to\": \"<NextStationName>\",\n    \"visit\": 1,\n    \"routing_rationale\": \"<one line when caps or non-default routing apply>\"\n  },\n  \"message\": {\n    \"mime\": \"text/markdown\",\n    \"body\": \"<optional markdown>\",\n    \"attachments\": [\n      {\n        \"name\": \"result\",\n        \"mime\": \"application/json\",\n        \"schema\": \"<key from workflow schemas map>\",\n        \"content\": { }\n      }\n    ]\n  }\n}\n```\n\n### Routing\n- Set **`metadata.to`** to a single station name (string). Multi-recipient is unsupported.\n- Default: next station in the workflow station list after yours; last station uses `\"to\": []`.\n- **`metadata.from`** must be your station name (the driver also stamps it).\n\n### Caps / budget\nA budget block may list remaining visits (and optional token/elapsed totals).\nIf your preferred `metadata.to` has remaining 0, do not route there. Follow station-specific fail vs accept-partial rules and set `metadata.routing_rationale`.\n\n### MIME\nUse property name **`mime`** everywhere (message body and attachments), e.g. `text/markdown`, `text/plain`, `application/json`.\n\n### Args\nHonor **Workflow args (JSON)**. Do not invent paths or titles.\n\n===== [qa.md] =====\n## QA\n\nPolish report; rewrite outputs if needed.\nSchema `qa`.\nSet `metadata.to` to []. Terminal.\n";
        extra += "\n\n## Visit / budget (authoritative)\n";
        extra += budget;
        extra += "\n\n## Your station\nName: " + "QA" + "\nVisit: " + visit_n + "\n";
        extra += "\nReturn exactly one post: metadata (from, to, visit, routing_rationale) + message (mime, body, attachments). Use mime everywhere (e.g. text/markdown, application/json). Set metadata.routing_rationale when routing is non-default or caps force a choice.\n";
        extra += "\n\n## Workflow args (JSON)\n";
        extra += workflow_args_json;
        extra += "\n\n## Attachment schema keys for this station\n";
        extra += "- " + "qa" + " (see thread.schemas)\n";
        let output = agent(
            "Station " + "QA" + "\n\n" + extra,
            #{
                label: "QA",
                capability_mode: "read-write",
                output_schema: make_post_schema(),
            }
        );
        let applied = apply_station_result(conversation, control, "QA", visit_n, output);
        conversation = applied.conversation;
        control = applied.control;
    } else {
        log("Unknown station: " + next_name);
        control.next = ();
    }
    next_name = control.next;
}


complete(#{
    "thread": conversation,
    control: control,
});

