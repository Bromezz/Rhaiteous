// --- thread+posts helpers ---
fn make_post_schema() {
    #{
        "type": "object",
        "required": ["metadata", "message"],
        "properties": #{
            "metadata": #{
                "type": "object",
                "required": ["from", "visit"],
                "properties": #{
                    "from": #{ "type": "string" },
                    "to": #{},
                    "visit": #{ "type": "integer", "minimum": 1 },
                    "tokens": #{ "type": "number" },
                    "duration_ms": #{ "type": "number" },
                    "routing_rationale": #{ "type": "string" },
                    "mode": #{ "type": "string" },
                    "advance": #{ "type": "string" },
                },
            },
            "message": #{
                "type": "object",
                "properties": #{
                    "mime": #{ "type": "string" },
                    "body": #{ "type": "string" },
                    "attachments": #{
                        "type": "array",
                        "items": #{
                            "type": "object",
                            "properties": #{
                                "name": #{ "type": "string" },
                                "mime": #{ "type": "string" },
                                "schema": #{ "type": "string" },
                                "content": #{},
                            },
                        },
                    },
                },
            },
        },
    }
}

fn ensure_control(control) {
    if control == () { control = #{}; }
    if control.station_run == () { control.station_run = #{}; }
    if control.token_total == () { control.token_total = 0; }
    if control.elapsed_total == () { control.elapsed_total = 0; }
    if control.tokens == () { control.tokens = []; }
    if control.elapsed == () { control.elapsed = []; }
    if control.next == () { control.next = (); }
    if control.current == () { control.current = (); }
    if control.warnings == () { control.warnings = []; }
    control
}

fn begin_station_visit(control, station_name) {
    control = ensure_control(control);
    let n = control.station_run[station_name];
    if n == () { n = 0; }
    control.station_run[station_name] = n + 1;
    control
}

fn budget_block(control) {
    control = ensure_control(control);
    let text = "Station visit budget (do not invent):\n";
    for name in control.stations {
        let used = control.station_run[name];
        if used == () { used = 0; }
        let maxv = control.caps[name];
        if maxv == () { maxv = 1; }
        let left = maxv - used;
        if left < 0 { left = 0; }
        let capped = "";
        if left == 0 { capped = " CAPPED"; }
        text += "  " + name + ": visit " + used + " of max " + maxv + " → REMAINING " + left + capped + "\n";
    }
    text += "token_total=" + control.token_total + " elapsed_total_ms=" + control.elapsed_total + "\n";
    text
}

fn max_visits_for(control, station_name) {
    let maxv = control.caps[station_name];
    if maxv == () { maxv = 1; }
    maxv
}

fn remaining_visits(control, station_name) {
    control = ensure_control(control);
    let used = control.station_run[station_name];
    if used == () { used = 0; }
    let maxv = max_visits_for(control, station_name);
    let left = maxv - used;
    if left < 0 { left = 0; }
    left
}

fn default_next_station(control, from_name) {
    let i = 0;
    let found = false;
    let nxt = ();
    for name in control.stations {
        if found {
            nxt = name;
            break;
        }
        if name == from_name {
            found = true;
        }
        i += 1;
    }
    nxt
}

fn normalize_to_field(raw_to) {
    if raw_to == () {
        return ();
    }
    if type_of(raw_to) == "array" {
        if raw_to.len() == 0 {
            return ();
        }
        if raw_to.len() > 1 {
            return #{ multi: true, first: raw_to[0] };
        }
        return raw_to[0];
    }
    raw_to
}

fn apply_station_result(conversation, control, station_name, visit_n, output) {
    control = ensure_control(control);
    let post = ();
    let tok = 0;
    let el = 0;
    if output != () {
        if output.tokens_used != () { tok = output.tokens_used; }
        if output.duration_ms != () { el = output.duration_ms; }
    }
    if output == () || !output.success || output.output == () {
        post = #{
            metadata: #{
                "from": station_name,
                "to": [],
                visit: visit_n,
                tokens: tok,
                duration_ms: el,
                routing_rationale: "Station agent failed; clearing next.",
            },
            message: #{
                mime: "text/plain",
                body: "ORCHESTRATOR: agent failed for " + station_name,
                attachments: [],
            },
        };
        control.next = ();
        conversation.posts.push(post);
        let tok_entry = #{};
        tok_entry[station_name] = tok;
        control.tokens.push(tok_entry);
        let el_entry = #{};
        el_entry[station_name] = el;
        control.elapsed.push(el_entry);
        control.token_total = control.token_total + tok;
        control.elapsed_total = control.elapsed_total + el;
        return #{ conversation: conversation, control: control };
    }
    post = output.output;
    if post.metadata == () { post.metadata = #{}; }
    if post.message == () {
        post.message = #{ mime: "text/markdown", body: "", attachments: [] };
    }
    if post.message.mime == () { post.message.mime = "text/markdown"; }
    if post.message.attachments == () { post.message.attachments = []; }
    post.metadata["from"] = station_name;
    post.metadata.visit = visit_n;
    post.metadata.tokens = tok;
    post.metadata.duration_ms = el;

    let norm = normalize_to_field(post.metadata["to"]);
    let chosen = ();
    if type_of(norm) == "map" && norm.multi == true {
        control.warnings.push("multi-to unsupported; using first recipient only");
        if post.metadata.routing_rationale == () || post.metadata.routing_rationale == "" {
            post.metadata.routing_rationale = "Multi-recipient to is unsupported; using first recipient only.";
        }
        chosen = norm.first;
    } else if norm == () {
        chosen = default_next_station(control, station_name);
        if post.metadata.routing_rationale == () || post.metadata.routing_rationale == "" {
            post.metadata.routing_rationale = "Default next station in list.";
        }
    } else {
        chosen = norm;
    }

    // Empty array terminal already mapped to ()
    if chosen != () {
        let used = control.station_run[chosen];
        if used == () { used = 0; }
        let maxv = max_visits_for(control, chosen);
        if used >= maxv {
            let fallback = default_next_station(control, station_name);
            if fallback == chosen {
                fallback = ();
            }
            if fallback != () {
                let used_fb = control.station_run[fallback];
                if used_fb == () { used_fb = 0; }
                if used_fb >= max_visits_for(control, fallback) {
                    fallback = ();
                }
            }
            post.metadata.routing_rationale = "Preferred station '" + chosen + "' is at max visits (" + used + "/" + maxv + "); routing adjusted.";
            chosen = fallback;
            control.warnings.push("capped route for " + station_name);
        }
    }

    if chosen == () {
        post.metadata["to"] = [];
    } else {
        post.metadata["to"] = chosen;
    }
    control.next = chosen;

    conversation.posts.push(post);
    let tok_entry2 = #{};
    tok_entry2[station_name] = tok;
    control.tokens.push(tok_entry2);
    let el_entry2 = #{};
    el_entry2[station_name] = el;
    control.elapsed.push(el_entry2);
    control.token_total = control.token_total + tok;
    control.elapsed_total = control.elapsed_total + el;
    #{ conversation: conversation, control: control }
}


