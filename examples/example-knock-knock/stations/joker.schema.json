{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["beat", "line"],
  "properties": {
    "beat": {
      "type": "string",
      "enum": ["knock", "setup", "punchline"]
    },
    "line": {
      "type": "string",
      "minLength": 1
    }
  }
}
