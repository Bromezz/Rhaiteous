{
  "name": "example-birthday-issues",
  "description": "Issues mining with workflow context: Intake → Formulation ⇄ Validation → Presentation → QA.",
  "finalizer": "finalize.mjs",
  "args": {
    "station_dir": "workflows/example-birthday-issues/stations",
    "source_candidates": [
      {
        "type": "file",
        "source": "workflows/example-birthday-issues/input/birthday-party-discussion.md"
      },
      {
        "type": "url",
        "source": "https://www.wikihow.com/Plan-a-Birthday-Party"
      }
    ],
    "out_dir": "workflows/example-birthday-issues/output",
    "curated": "workflows/example-birthday-issues/output/curated.md",
    "flow_json_name": "example-birthday-issues-thread.json",
    "issues_md_name": "example-birthday-issues-issues.md",
    "report_title": "Birthday planning issues"
  },
  "schemas": {
    "intake": "intake.schema.json",
    "formulation": "formulation.schema.json",
    "validation": "validation.schema.json",
    "presentation": "presentation.schema.json",
    "qa": "qa.schema.json"
  },
  "prompts": {
    "thread_common": "common.prompt.md",
    "intake": "intake.prompt.md",
    "formulation": "formulation.prompt.md",
    "validation": "validation.prompt.md",
    "presentation": "presentation.prompt.md",
    "qa": "qa.prompt.md"
  },
  "stations": [
    {
      "name": "Intake",
      "uiDescription": "Verify sources; curate numbered verbatim corpus",
      "prompt": ["thread_common", "intake"],
      "schemas": ["intake"],
      "capability_mode": "read-write",
      "max_visits": 1
    },
    {
      "name": "Formulation",
      "uiDescription": "Surface issues from curated Ids only",
      "prompt": ["thread_common", "formulation"],
      "schemas": ["formulation"],
      "capability_mode": "read-write",
      "max_visits": 3
    },
    {
      "name": "Validation",
      "uiDescription": "Coverage gate then Id-grounded validity",
      "prompt": ["thread_common", "validation"],
      "schemas": ["validation"],
      "capability_mode": "read-write",
      "max_visits": 12
    },
    {
      "name": "Presentation",
      "uiDescription": "Issues report with Evidence Id+quote",
      "prompt": ["thread_common", "presentation"],
      "schemas": ["presentation"],
      "capability_mode": "read-write",
      "max_visits": 12
    },
    {
      "name": "QA",
      "uiDescription": "Polish wording; preserve Evidence",
      "prompt": ["thread_common", "qa"],
      "schemas": ["qa"],
      "capability_mode": "read-write",
      "max_visits": 12
    }
  ]
}
