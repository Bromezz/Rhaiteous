{
  "name": "minimal-summary",
  "description": "Tiny demo workflow: one agent returns a structured summary",
  "phases": [
    { "title": "Summarize", "detail": "single agent with JSON Schema output" }
  ],
  "args": {
    "target": { "required": true },
    "label": { "default": "run" }
  },
  "schemas": {
    "summary": "summary.schema.json"
  },
  "steps": [
    { "op": "phase", "title": "Summarize" },
    {
      "op": "agent",
      "as": "result",
      "label": "summarize",
      "agent_type": "analyst",
      "capability_mode": "read-only",
      "output_schema": "summary",
      "prompt": ["minimal-summarize.txt"]
    },
    {
      "op": "if_failed",
      "path": "result",
      "then": [
        {
          "op": "complete",
          "value": { "summary": "agent failed", "ok": false }
        }
      ]
    },
    {
      "op": "complete_from",
      "from": "result"
    }
  ]
}
