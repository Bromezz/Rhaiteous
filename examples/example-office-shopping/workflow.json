{
  "name": "example-office-shopping",
  "description": "Office supply cycle with workflow context: Intake → Inventory → Audit → Procurement → Purchasing.",
  "finalizer": "finalize.mjs",
  "args": {
    "station_dir": "workflows/example-office-shopping/stations",
    "requests_dir": "workflows/example-office-shopping/input",
    "out_dir": "workflows/example-office-shopping/output",
    "company_name": "Acme Office",
    "cycle": "twice-weekly"
  },
  "schemas": {
    "intake": "intake.schema.json",
    "inventory": "inventory.schema.json",
    "audit": "audit.schema.json",
    "procurement": "procurement.schema.json",
    "purchasing": "purchasing.schema.json"
  },
  "prompts": {
    "thread_common": "common.prompt.md",
    "intake": "intake.prompt.md",
    "inventory": "inventory.prompt.md",
    "audit": "audit.prompt.md",
    "procurement": "procurement.prompt.md",
    "purchasing": "purchasing.prompt.md"
  },
  "stations": [
    {
      "name": "Intake",
      "uiDescription": "collect requests",
      "prompt": ["thread_common", "intake"],
      "schemas": ["intake"],
      "capability_mode": "all",
      "max_visits": 1
    },
    {
      "name": "Inventory",
      "uiDescription": "compile line items",
      "prompt": ["thread_common", "inventory"],
      "schemas": ["inventory"],
      "capability_mode": "all",
      "max_visits": 1
    },
    {
      "name": "Audit",
      "uiDescription": "challenge each line",
      "prompt": ["thread_common", "audit"],
      "schemas": ["audit"],
      "capability_mode": "all",
      "max_visits": 1
    },
    {
      "name": "Procurement",
      "uiDescription": "vendor picks",
      "prompt": ["thread_common", "procurement"],
      "schemas": ["procurement"],
      "capability_mode": "all",
      "max_visits": 1
    },
    {
      "name": "Purchasing",
      "uiDescription": "record purchases; write report.md",
      "prompt": ["thread_common", "purchasing"],
      "schemas": ["purchasing"],
      "capability_mode": "all",
      "max_visits": 1
    }
  ]
}
