{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhaiteous.local/packs/example-office-shopping/schema.json",
  "title": "ShoppingPayload",
  "description": "Shared flow.payload for the office-shopping station pipeline.",
  "type": "object",
  "required": [
    "requests",
    "items",
    "survivors",
    "dropped_items",
    "audit_verdicts",
    "vendor_picks",
    "transactions",
    "cycle_status",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "requests": {
      "$ref": "stations/shopping-requests.schema.json#/properties/requests"
    },
    "items": {
      "$ref": "stations/shopping-items.schema.json#/properties/items"
    },
    "survivors": {
      "type": "array",
      "description": "Line items that passed Audit (real=true with evidence).",
      "items": {
        "$ref": "stations/shopping-items.schema.json#/properties/items/items"
      }
    },
    "dropped_items": {
      "type": "array",
      "description": "Line items rejected by Audit.",
      "items": {
        "$ref": "stations/shopping-items.schema.json#/properties/items/items"
      }
    },
    "audit_verdicts": {
      "type": "array",
      "description": "Per-item audit results aligned with Inventory items.",
      "items": {
        "$ref": "stations/shopping-audit.schema.json"
      }
    },
    "vendor_picks": {
      "type": "array",
      "description": "Flattened vendor picks for surviving items.",
      "items": {
        "$ref": "stations/shopping-vendor-pick.schema.json#/properties/picks/items"
      }
    },
    "transactions": {
      "type": "array",
      "description": "Purchase records from Purchasing.",
      "items": {
        "$ref": "stations/shopping-purchase-one.schema.json#/properties/transactions/items"
      }
    },
    "cycle_status": {
      "type": "string",
      "description": "Short status label for the cycle (e.g. intake_ok, complete)."
    },
    "summary": {
      "type": "string",
      "description": "Human-readable cycle summary."
    }
  }
}
