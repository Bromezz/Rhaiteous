//generated by rhaiteous — do not hand-edit
//source workflow JSON is the authoring surface; re-run the compiler after changes

let meta = #{
    name: "office-shopping",
    description: "Twice-weekly office supply cycle: intake requests, inventory items, audit, procure vendors, purchase and record transactions",
    phases: [
        #{
            title: "Intake",
            detail: "collect and deposit requests from email, chat, forms",
        },
        #{
            title: "Inventory",
            detail: "compile specific items and quantities per request",
        },
        #{
            title: "Audit",
            detail: "challenge each line across validity facets",
        },
        #{
            title: "Procurement",
            detail: "select a vendor for each surviving item",
        },
        #{
            title: "Purchasing",
            detail: "buy and record each transaction",
        },
    ],
};

//json schemas loaded from disk (generated; do not hand-edit)

let audit_schema = #{
  "$comment": "Audit station: adversarial check of one line item across necessity, quantity, policy, duplicates, and budget reasonableness. zip_filter keeps items when real==true and evidence is non-empty.",
  "$id": "https://rhaiteous.local/schemas/shopping-audit.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  additionalProperties: false,
  properties: #{
    evidence: #{
      "$comment": "Independent citations supporting the verdict. Empty array drops the item even if real were true.",
      items: #{
        additionalProperties: false,
        properties: #{
          quote: #{
            "type": "string",
          },
          source: #{
            "type": "string",
          },
        },
        required: [
          "source",
          "quote",
        ],
        "type": "object",
      },
      "type": "array",
    },
    facets: #{
      "$comment": "Structured multi-facet audit notes (validity dimensions).",
      additionalProperties: false,
      properties: #{
        budget_reasonable: #{
          "$comment": "Plausible spend for a small office cycle.",
          "type": "string",
        },
        necessity: #{
          "$comment": "Is this needed for office operations this cycle?",
          "type": "string",
        },
        not_duplicate: #{
          "$comment": "Not already covered by another line or recent purchase.",
          "type": "string",
        },
        policy_ok: #{
          "$comment": "Allowed under company purchasing policy.",
          "type": "string",
        },
        quantity_sane: #{
          "$comment": "Is quantity proportional to headcount / burn rate?",
          "type": "string",
        },
      },
      required: [
        "necessity",
        "quantity_sane",
        "not_duplicate",
        "policy_ok",
        "budget_reasonable",
      ],
      "type": "object",
    },
    id: #{
      "$comment": "Must match the line item id under review.",
      "type": "string",
    },
    real: #{
      "$comment": "true only when the line should proceed to procurement. false drops it in zip_filter.",
      "type": "boolean",
    },
    reason: #{
      "$comment": "Short overall rationale for pass/fail.",
      "type": "string",
    },
  },
  required: [
    "id",
    "real",
    "reason",
    "facets",
    "evidence",
  ],
  title: "ShoppingAuditVerdict",
  "type": "object",
};

let items_schema = #{
  "$comment": "Inventory station: concrete SKUs/items and quantities derived from deposited requests.",
  "$id": "https://rhaiteous.local/schemas/shopping-items.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  additionalProperties: false,
  properties: #{
    items: #{
      "$comment": "Normalized line items for this twice-weekly cycle. Cap keeps audit fan-out bounded.",
      items: #{
        "$comment": "One buyable line. id must stay stable through Audit, Procurement, and Purchasing.",
        additionalProperties: false,
        properties: #{
          category: #{
            "$comment": "Optional bucket: paper, kitchen, IT, cleaning, other.",
            "type": "string",
          },
          evidence: #{
            "$comment": "Citations back to deposited requests or policy docs.",
            items: #{
              additionalProperties: false,
              properties: #{
                quote: #{
                  description: "Supporting excerpt",
                  "type": "string",
                },
                source: #{
                  description: "Request id, path, or URL",
                  "type": "string",
                },
              },
              required: [
                "source",
                "quote",
              ],
              "type": "object",
            },
            "type": "array",
          },
          id: #{
            "$comment": "Stable line id; office-shopping prompt uses {requestId}-item-N (e.g. req-001-item-1).",
            "type": "string",
          },
          name: #{
            "$comment": "Specific product description (not a vague category).",
            "type": "string",
          },
          quantity: #{
            "$comment": "How many units to buy this cycle.",
            "type": "number",
          },
          request_ids: #{
            "$comment": "Intake request ids that drove this line (merge duplicates here).",
            items: #{
              "type": "string",
            },
            "type": "array",
          },
          unit: #{
            "$comment": "Unit of measure: each, box, ream, pack, case, etc.",
            "type": "string",
          },
        },
        required: [
          "id",
          "name",
          "quantity",
          "unit",
          "request_ids",
          "evidence",
        ],
        "type": "object",
      },
      maxItems: 40,
      "type": "array",
    },
  },
  required: [
    "items",
  ],
  title: "ShoppingItemsResult",
  "type": "object",
};

let purchase_one_schema = #{
  "$comment": "Purchasing station (per vendor pick): one transaction wrapped in transactions[] for collect.",
  "$id": "https://rhaiteous.local/schemas/shopping-purchase-one.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  additionalProperties: false,
  properties: #{
    transactions: #{
      "$comment": "Single-element array: the purchase (or simulation) for this pick.",
      items: #{
        additionalProperties: false,
        properties: #{
          amount: #{
            "type": "number",
          },
          confirmation_ref: #{
            "type": "string",
          },
          currency: #{
            "type": "string",
          },
          id: #{
            "type": "string",
          },
          item_id: #{
            "type": "string",
          },
          notes: #{
            "type": "string",
          },
          quantity: #{
            "type": "number",
          },
          status: #{
            "$comment": "purchased | backordered | failed | simulated",
            "type": "string",
          },
          vendor_name: #{
            "type": "string",
          },
        },
        required: [
          "id",
          "item_id",
          "vendor_name",
          "quantity",
          "status",
          "confirmation_ref",
          "notes",
        ],
        "type": "object",
      },
      maxItems: 1,
      minItems: 1,
      "type": "array",
    },
  },
  required: [
    "transactions",
  ],
  title: "ShoppingPurchaseOneResult",
  "type": "object",
};

let requests_schema = #{
  "$comment": "Intake station: every supply request gathered from email, chat, forms, etc., deposited into a structured catalog for the shopping cycle.",
  "$id": "https://rhaiteous.local/schemas/shopping-requests.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  additionalProperties: false,
  properties: #{
    notes: #{
      "$comment": "Intake narrative: coverage, noise skipped, open questions.",
      "type": "string",
    },
    requests: #{
      "$comment": "One entry per distinct request. Empty is allowed; the workflow short-circuits later if nothing arrived.",
      items: #{
        "$comment": "A single inbound request, re-posited with a stable id and source locator.",
        additionalProperties: false,
        properties: #{
          body: #{
            "$comment": "Full request text as received (or cleaned transcript).",
            "type": "string",
          },
          channel: #{
            "$comment": "How the request arrived: email, chat, form, voice-note, other.",
            "type": "string",
          },
          id: #{
            "$comment": "Stable id for this cycle, e.g. req-001.",
            "type": "string",
          },
          received_at: #{
            "$comment": "Optional ISO-ish timestamp when the request arrived.",
            "type": "string",
          },
          requester: #{
            "$comment": "Person or team who asked.",
            "type": "string",
          },
          source: #{
            "$comment": "Where to re-open the original: mailbox path, chat permalink, file path, etc.",
            "type": "string",
          },
          summary: #{
            "$comment": "One-line restatement of what they want.",
            "type": "string",
          },
        },
        required: [
          "id",
          "channel",
          "requester",
          "summary",
          "body",
          "source",
        ],
        "type": "object",
      },
      "type": "array",
    },
  },
  required: [
    "requests",
    "notes",
  ],
  title: "ShoppingRequestsResult",
  "type": "object",
};

let vendor_pick_schema = #{
  "$comment": "Procurement station (per line): one vendor choice wrapped in picks[] so parallel results can be collect'ed.",
  "$id": "https://rhaiteous.local/schemas/shopping-vendor-pick.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  additionalProperties: false,
  properties: #{
    picks: #{
      "$comment": "Always a single-element array for this shard (the item under review).",
      items: #{
        additionalProperties: false,
        properties: #{
          currency: #{
            "type": "string",
          },
          evidence: #{
            items: #{
              additionalProperties: false,
              properties: #{
                quote: #{
                  "type": "string",
                },
                source: #{
                  "type": "string",
                },
              },
              required: [
                "source",
                "quote",
              ],
              "type": "object",
            },
            "type": "array",
          },
          fulfillment: #{
            "$comment": "URL, SKU, catalog id, or buy instruction.",
            "type": "string",
          },
          item_id: #{
            "type": "string",
          },
          rationale: #{
            "type": "string",
          },
          unit_price_estimate: #{
            "type": "number",
          },
          vendor_name: #{
            "type": "string",
          },
        },
        required: [
          "item_id",
          "vendor_name",
          "fulfillment",
          "rationale",
          "evidence",
        ],
        "type": "object",
      },
      maxItems: 1,
      minItems: 1,
      "type": "array",
    },
  },
  required: [
    "picks",
  ],
  title: "ShoppingVendorPickResult",
  "type": "object",
};

//workflow args bound to locals
let company_name = if args == () || args.company_name == () { "Acme Office" } else { args.company_name };
let cycle = if args == () || args.cycle == () { "twice-weekly" } else { args.cycle };
let requests_dir = if args == () { () } else { args.requests_dir };
if requests_dir == () { pause("verification", "Pass args.requests_dir."); }

//set cycle_status
let cycle_status = ();

//phase Intake
phase("Intake");

//agent step: intake
let p = "";
p += "\n===== [shopping-intake.txt] =====\nYou are the Intake station for a twice-weekly office supply shopping cycle.\n\nCompany: ";
p += company_name;
p += "\nCycle label: ";
p += cycle;
p += "\nRequests root: ";
p += requests_dir;
p += "\n\nCollect every supply request you can find under the requests root (email exports,\nchat transcripts, forms, notes). For each request:\n- assign a stable id (req-001, …)\n- record channel, requester, summary, full body\n- set source to a path or locator so later stations can re-open it\n- deposit (reposit) it into the structured requests array — do not leave raw-only\n\nSkip spam and pure conversation with no supply ask.\nnotes = short intake narrative (what you covered, what you skipped).\nReturn the shopping-requests schema.\n";
let intake = agent(p, #{
  prompt: p,
  label: "intake",
  agent_type: "stickler",
  capability_mode: "read-only",
  output_schema: requests_schema,
});

//if_failed intake
if intake == () || !intake.success {
  //set cycle_status
  cycle_status = "intake_failed";

  //complete run
  complete(#{
    status: cycle_status,
    summary: "intake failed",
    transactions: [],
  });
} else {
  //set cycle_status
  cycle_status = "intake_ok";

  //log progress
  let m = "";
  m += "Intake agent succeeded for ";
  m += company_name;
  log(m);
}

//bind intake.output.requests → requests
let requests = intake.output.requests;

//if_empty requests
if requests.len() == 0 {
  //complete run
  complete(#{
    summary: "No supply requests this cycle.",
    transactions: [],
  });
} else {
  //log progress
  let m = "";
  m += "Intake complete for ";
  m += company_name;
  m += " (";
  m += cycle;
  m += ")";
  log(m);
}

//phase Inventory
phase("Inventory");

//parallel over requests → inventory_results
let inventory_results_jobs = [];
let ri = 0;
for req in requests {
  let p = "";
  p += "\n===== [shopping-inventory.txt] =====\nYou are the Inventory station for a twice-weekly office shopping cycle.\nNormalize THIS deposited request into concrete buyable line items.\n\nCompany: ";
  p += company_name;
  p += "\nCycle: ";
  p += cycle;
  p += "\n\nRequest:\nid: ";
  p += req.id;
  p += "\nchannel: ";
  p += req.channel;
  p += "\nrequester: ";
  p += req.requester;
  p += "\nsummary: ";
  p += req.summary;
  p += "\nbody: ";
  p += req.body;
  p += "\nsource: ";
  p += req.source;
  p += "\n\nRules:\n- emit zero or more specific products (not vague categories)\n- quantity + unit must be explicit\n- request_ids must include ";
  p += req.id;
  p += " (and only this request for this shard)\n- evidence: array of {source, quote} citing this request\n- id format: ";
  p += req.id;
  p += "-item-1, ";
  p += req.id;
  p += "-item-2, …\n\nReturn the shopping-items schema (items array for this request only).\n";
  inventory_results_jobs.push(#{
    prompt: p,
    agent_type: "analyst",
    capability_mode: "read-only",
    output_schema: items_schema,
    label: "inventory:" + ri.to_string(),
  });
  ri += 1;
}
let inventory_results = parallel(inventory_results_jobs);

//collect inventory_results[].output.items → items
let items = [];
for r in inventory_results {
  if r != () && r.success && r.output.items != () {
    for item in r.output.items {
      items.push(item);
    }
  }
}

//if_empty items
if items.len() == 0 {
  //complete run
  complete(#{
    summary: "No line items to buy.",
    transactions: [],
  });
} else {
  //log progress
  let m = "";
  m += "Inventory produced line items for ";
  m += company_name;
  log(m);
}

//phase Audit
phase("Audit");

//parallel over items → audit_results
let audit_results_jobs = [];
let ai = 0;
for item in items {
  let p = "";
  p += "\n===== [shopping-audit.txt] =====\nYou are the Audit station. Adversarially validate ONE line item for this office shopping cycle.\n\nCompany: ";
  p += company_name;
  p += "\nCycle: ";
  p += cycle;
  p += "\n\nLine under review:\nid: ";
  p += item.id;
  p += "\nname: ";
  p += item.name;
  p += "\nquantity: ";
  p += item.quantity;
  p += "\nunit: ";
  p += item.unit;
  p += "\n\nChallenge validity across ALL facets (fill each facets.* field):\n- necessity — needed for operations this cycle?\n- quantity_sane — proportional, not a bulk accident?\n- not_duplicate — not already covered elsewhere?\n- policy_ok — allowed under normal small-office purchasing policy?\n- budget_reasonable — spend plausible for a twice-weekly cycle?\n\nreal=true only when the line should proceed to procurement.\nevidence must be a non-empty array of {source, quote} you can stand behind\n(paths, request ids, or policy notes). Return the same id.\nReturn the shopping-audit schema.\n";
  audit_results_jobs.push(#{
    prompt: p,
    agent_type: "skeptic",
    capability_mode: "read-only",
    output_schema: audit_schema,
    label: "audit:" + ai.to_string(),
  });
  ai += 1;
}
let audit_results = parallel(audit_results_jobs);

//zip_filter items with audit_results → survivors
let survivors = [];
let dropped_items = [];
let zi = 0;
for v in audit_results {
  let cand = items[zi];
  if v != () && v.success && v.output.real == true && v.output.evidence != () && v.output.evidence.len() > 0 {
    survivors.push(cand);
  } else {
    dropped_items.push(cand.id);
  }
  zi += 1;
}

//if empty survivors
if survivors.len() == 0 {
  //set cycle_status
  cycle_status = "audit_none_survived";

  //complete run
  complete(#{
    dropped: dropped_items,
    status: cycle_status,
    summary: "No items survived audit.",
    transactions: [],
  });
} else if dropped_items.len() > 0 {
  //set cycle_status
  cycle_status = "audit_partial";

  //log progress
  let m = "";
  m += "Audit complete for ";
  m += company_name;
  m += " (some items dropped)";
  log(m);
} else {
  //set cycle_status
  cycle_status = "audit_all_passed";

  //log progress
  let m = "";
  m += "Audit complete for ";
  m += company_name;
  m += " (all items passed)";
  log(m);
}

//phase Procurement
phase("Procurement");

//parallel over survivors → procurement_results
let procurement_results_jobs = [];
let pi = 0;
for item in survivors {
  let p = "";
  p += "\n===== [shopping-procurement.txt] =====\nYou are the Procurement station. Choose ONE vendor for this audited line item.\n\nCompany: ";
  p += company_name;
  p += "\nCycle: ";
  p += cycle;
  p += "\n\nLine item:\nid: ";
  p += item.id;
  p += "\nname: ";
  p += item.name;
  p += "\nquantity: ";
  p += item.quantity;
  p += "\nunit: ";
  p += item.unit;
  p += "\n\nReturn picks as a one-element array with:\n- item_id = ";
  p += item.id;
  p += "\n- vendor_name, fulfillment (URL/SKU/instruction)\n- optional unit_price_estimate + currency\n- rationale, evidence[{source,quote}]\n\nReturn the shopping-vendor-pick schema.\n";
  procurement_results_jobs.push(#{
    prompt: p,
    agent_type: "analyst",
    capability_mode: "read-only",
    output_schema: vendor_pick_schema,
    label: "procure:" + pi.to_string(),
  });
  pi += 1;
}
let procurement_results = parallel(procurement_results_jobs);

//collect procurement_results[].output.picks → vendor_picks
let vendor_picks = [];
for r in procurement_results {
  if r != () && r.success && r.output.picks != () {
    for item in r.output.picks {
      vendor_picks.push(item);
    }
  }
}

//if_empty vendor_picks
if vendor_picks.len() == 0 {
  //complete run
  complete(#{
    items: survivors,
    summary: "procurement produced no vendor picks",
    transactions: [],
  });
} else {
  //log progress
  let m = "";
  m += "Procurement ready for ";
  m += company_name;
  log(m);
}

//phase Purchasing
phase("Purchasing");

//parallel over vendor_picks → purchase_results
let purchase_results_jobs = [];
let xi = 0;
for pick in vendor_picks {
  let p = "";
  p += "\n===== [shopping-purchasing.txt] =====\nYou are the Purchasing station. Purchase (or simulate) THIS vendor pick and record one transaction.\n\nCompany: ";
  p += company_name;
  p += "\nCycle: ";
  p += cycle;
  p += "\n\nVendor pick:\nitem_id: ";
  p += pick.item_id;
  p += "\nvendor_name: ";
  p += pick.vendor_name;
  p += "\nfulfillment: ";
  p += pick.fulfillment;
  p += "\n\nPerform a real purchase when tools/capability allow; otherwise status=simulated\nwith an honest confirmation_ref. Return transactions as a one-element array:\nid (txn-…), item_id, vendor_name, quantity, status, confirmation_ref, notes,\noptional amount/currency.\n\nReturn the shopping-purchase-one schema.\n";
  purchase_results_jobs.push(#{
    prompt: p,
    agent_type: "general-purpose",
    capability_mode: "execute",
    output_schema: purchase_one_schema,
    label: "purchase:" + xi.to_string(),
  });
  xi += 1;
}
let purchase_results = parallel(purchase_results_jobs);

//collect purchase_results[].output.transactions → transactions
let transactions = [];
for r in purchase_results {
  if r != () && r.success && r.output.transactions != () {
    for item in r.output.transactions {
      transactions.push(item);
    }
  }
}

//hoist binding for branch assignment
let final_report = ();
//if empty transactions
if transactions.len() == 0 {
  //set cycle_status
  cycle_status = "no_transactions";

  //set final_report
  final_report = #{
    dropped: dropped_items,
    items_audited: survivors,
    requests: requests,
    status: cycle_status,
    summary: "office shopping cycle finished with no recorded transactions",
    transactions: [],
    vendor_picks: vendor_picks,
  };

  //complete run
  complete(final_report);
} else {
  //set cycle_status
  cycle_status = "complete";

  //set final_report
  final_report = #{
    dropped: dropped_items,
    items_audited: survivors,
    requests: requests,
    status: cycle_status,
    summary: "office shopping cycle complete",
    transactions: transactions,
    vendor_picks: vendor_picks,
  };

  //complete run
  complete(final_report);
}

