//generated by rhaiteous — do not hand-edit
//source workflow JSON is the authoring surface; re-run the compiler after changes

let meta = #{
    name: "client-issues",
    description: "Mine client docs for issues of concern; adversarially verify; complete with survivors",
    phases: [
        #{
            title: "Intake",
            detail: "inventory source docs",
        },
        #{
            title: "Analysis",
            detail: "parallel analysts extract candidates",
        },
        #{
            title: "Challenge",
            detail: "parallel skeptics verify candidates",
        },
    ],
};

//json schemas loaded from disk (generated; do not hand-edit)

let candidates_schema = #{
  "$id": "https://rhaiteous.local/schemas/candidates.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  additionalProperties: false,
  properties: #{
    candidates: #{
      items: #{
        additionalProperties: false,
        properties: #{
          confidence: #{
            "type": "string",
          },
          evidence: #{
            "type": "string",
          },
          id: #{
            "type": "string",
          },
          kind: #{
            "type": "string",
          },
          source_path: #{
            "type": "string",
          },
          statement: #{
            "type": "string",
          },
        },
        required: [
          "id",
          "kind",
          "statement",
          "evidence",
          "source_path",
        ],
        "type": "object",
      },
      maxItems: 20,
      "type": "array",
    },
  },
  required: [
    "candidates",
  ],
  title: "CandidatesResult",
  "type": "object",
};

let inventory_schema = #{
  "$id": "https://rhaiteous.local/schemas/inventory.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  additionalProperties: false,
  properties: #{
    files: #{
      items: #{
        "type": "string",
      },
      "type": "array",
    },
    notes: #{
      "type": "string",
    },
  },
  required: [
    "files",
    "notes",
  ],
  title: "InventoryResult",
  "type": "object",
};

let verdict_schema = #{
  "$id": "https://rhaiteous.local/schemas/verdict.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  additionalProperties: false,
  properties: #{
    evidence: #{
      "type": "string",
    },
    id: #{
      "type": "string",
    },
    real: #{
      "type": "boolean",
    },
    reason: #{
      "type": "string",
    },
  },
  required: [
    "id",
    "real",
    "reason",
    "evidence",
  ],
  title: "VerdictResult",
  "type": "object",
};

//workflow args bound to locals
let client_name = if args == () || args.client_name == () { "client" } else { args.client_name };
let docs_dir = if args == () { () } else { args.docs_dir };
if docs_dir == () { pause("verification", "Pass args.docs_dir."); }

//phase Intake
phase("Intake");

//agent step: intake
let p = "";
p += "Inventory source documents for issue mining.\nClient: ";
p += client_name;
p += "\nDocs root: ";
p += docs_dir;
p += "\nUse list_dir/read tools. Return every relevant file path under that root.\nSkip binaries and noise. notes = brief scope summary.";
let intake = agent(p, #{
  prompt: p,
  label: "intake",
  agent_type: "stickler",
  capability_mode: "read-only",
  output_schema: inventory_schema,
});

//if_failed intake
if intake == () || !intake.success {
  //complete run
  complete(#{
    issues: [],
    summary: "intake failed",
  });
}

//bind intake.output.files → files
let files = intake.output.files;

//if_empty files
if files.len() == 0 {
  //complete run
  complete(#{
    issues: [],
    summary: "No source files found.",
  });
}

//log progress
let m = "";
m += "Intake complete for ";
m += client_name;
log(m);

//phase Analysis
phase("Analysis");

//parallel over files → analysis_results
let analysis_results_jobs = [];
let i = 0;
for f in files {
  let p = "";
  p += "Extract issues of concern from this source file only.\nClient: ";
  p += client_name;
  p += "\nFile: ";
  p += f;
  p += "\nRead the file with tools. Return up to 20 candidates.\nid format: ";
  p += i.to_string();
  p += "-<short-slug>. Empty list only after reading the file.";
  analysis_results_jobs.push(#{
    prompt: p,
    agent_type: "analyst",
    capability_mode: "read-only",
    output_schema: candidates_schema,
    label: "analyze:" + i.to_string(),
  });
  i += 1;
}
let analysis_results = parallel(analysis_results_jobs);

//collect analysis_results[].output.candidates → candidates
let candidates = [];
for r in analysis_results {
  if r != () && r.success && r.output.candidates != () {
    for item in r.output.candidates {
      candidates.push(item);
    }
  }
}

//if_empty candidates
if candidates.len() == 0 {
  //complete run
  complete(#{
    issues: [],
    summary: "No candidates.",
  });
}

//phase Challenge
phase("Challenge");

//parallel over candidates → verdict_results
let verdict_results_jobs = [];
let vi = 0;
for c in candidates {
  let p = "";
  p += "Adversarially verify this candidate issue against the source.\nRead source_path yourself. real=true only with independent evidence.\nReturn the same id.\nCandidate JSON fields to honor:\nUse tools on the source path from the candidate; statement and evidence are in your task context via the orchestrator payload.\nid: ";
  p += c.id;
  p += "\nkind: ";
  p += c.kind;
  p += "\nstatement: ";
  p += c.statement;
  p += "\nclaimed evidence: ";
  p += c.evidence;
  p += "\nsource_path: ";
  p += c.source_path;
  verdict_results_jobs.push(#{
    prompt: p,
    agent_type: "skeptic",
    capability_mode: "read-only",
    output_schema: verdict_schema,
    label: "verify:" + vi.to_string(),
  });
  vi += 1;
}
let verdict_results = parallel(verdict_results_jobs);

//zip_filter candidates with verdict_results → survivors
let survivors = [];
let dropped = [];
let zi = 0;
for v in verdict_results {
  let cand = candidates[zi];
  if v != () && v.success && v.output.real == true && v.output.evidence != () && v.output.evidence != "" {
    survivors.push(cand);
  } else {
    dropped.push(cand.id);
  }
  zi += 1;
}

//if_empty survivors
if survivors.len() == 0 {
  //complete run
  complete(#{
    issues: [],
    summary: "None survived challenge.",
  });
}

//complete run
complete(#{
  dropped: dropped,
  issues: survivors,
  summary: "challenge complete",
});

