//generated by rhaiteous — do not hand-edit
//source workflow JSON is the authoring surface; re-run the compiler after changes

let meta = #{
    name: "minimal-summary",
    description: "Tiny demo workflow: one agent returns a structured summary",
    phases: [
        #{
            title: "Summarize",
            detail: "single agent with JSON Schema output",
        },
    ],
};

//json schemas loaded from disk (generated; do not hand-edit)

let summary_schema = #{
  "$comment": "Minimal demo contract: one agent returns a short summary plus a self-assessed ok flag. Used by examples/minimal.workflow.json.",
  "$id": "https://rhaiteous.local/schemas/summary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  additionalProperties: false,
  properties: #{
    ok: #{
      "$comment": "Agent-owned success signal (not the same as the host agent.success). Set true only when summary is usable.",
      description: "Whether the step succeeded on its own terms",
      "type": "boolean",
    },
    summary: #{
      "$comment": "Human-readable result for the orchestrator UI / complete payload; keep it concise.",
      description: "Short human-readable summary",
      "type": "string",
    },
  },
  required: [
    "summary",
    "ok",
  ],
  title: "SummaryResult",
  "type": "object",
};

//workflow args bound to locals
let label = if args == () || args.label == () { "run" } else { args.label };
let target = if args == () { () } else { args.target };
if target == () { pause("verification", "Pass args.target."); }

//phase Summarize
phase("Summarize");

//agent step: result
let p = "";
p += "\n===== [minimal-summarize.txt] =====\nSummarize the subject below into the required schema.\nUse tools if the subject is a path; otherwise answer from the text.\nSubject: ";
p += target;
p += "\nLabel: ";
p += label;
p += "\nSet ok=true when you produced a usable summary.\n";
let result = agent(p, #{
  prompt: p,
  label: "summarize",
  agent_type: "analyst",
  capability_mode: "read-only",
  output_schema: summary_schema,
});

//if_failed result
if result == () || !result.success {
  //complete run
  complete(#{
    ok: false,
    summary: "agent failed",
  });
}

//complete from result.output
complete(result.output);

