{
  "name": "client-issues",
  "description": "Mine client docs for issues of concern; adversarially verify; complete with survivors",
  "phases": [
    { "title": "Intake", "detail": "inventory source docs" },
    { "title": "Analysis", "detail": "parallel analysts extract candidates" },
    { "title": "Challenge", "detail": "parallel skeptics verify candidates" }
  ],
  "args": {
    "docs_dir": { "required": true },
    "client_name": { "default": "client" }
  },
  "schemas": {
    "inventory": "inventory.schema.json",
    "candidates": "candidates.schema.json",
    "verdict": "verdict.schema.json"
  },
  "steps": [
    { "op": "phase", "title": "Intake" },
    {
      "op": "agent",
      "as": "intake",
      "label": "intake",
      "agent_type": "stickler",
      "capability_mode": "read-only",
      "output_schema": "inventory",
      "prompt": ["client-intake.txt"]
    },
    {
      "op": "if_failed",
      "path": "intake",
      "then": [
        {
          "op": "complete",
          "value": { "summary": "intake failed", "issues": [] }
        }
      ]
    },
    {
      "op": "bind",
      "as": "files",
      "from": "intake",
      "field": "files"
    },
    {
      "op": "if_empty",
      "path": "files",
      "then": [
        {
          "op": "complete",
          "value": { "summary": "No source files found.", "issues": [] }
        }
      ]
    },
    {
      "op": "log",
      "message": "Intake complete for {{args.client_name}}"
    },
    { "op": "phase", "title": "Analysis" },
    {
      "op": "parallel",
      "as": "analysis_results",
      "over": "files",
      "item_as": "f",
      "index_as": "i",
      "label_prefix": "analyze",
      "agent_type": "analyst",
      "capability_mode": "read-only",
      "output_schema": "candidates",
      "prompt": ["client-analyze.txt"]
    },
    {
      "op": "collect",
      "as": "candidates",
      "from": "analysis_results",
      "field": "candidates"
    },
    {
      "op": "if_empty",
      "path": "candidates",
      "then": [
        {
          "op": "complete",
          "value": { "summary": "No candidates.", "issues": [] }
        }
      ]
    },
    { "op": "phase", "title": "Challenge" },
    {
      "op": "parallel",
      "as": "verdict_results",
      "over": "candidates",
      "item_as": "c",
      "index_as": "vi",
      "label_prefix": "verify",
      "agent_type": "skeptic",
      "capability_mode": "read-only",
      "output_schema": "verdict",
      "prompt": ["client-verify.txt"]
    },
    {
      "op": "zip_filter",
      "as": "survivors",
      "dropped_as": "dropped",
      "left": "candidates",
      "right": "verdict_results"
    },
    {
      "op": "if_empty",
      "path": "survivors",
      "then": [
        {
          "op": "complete",
          "value": { "summary": "None survived challenge.", "issues": [] }
        }
      ]
    },
    {
      "op": "complete",
      "value": {
        "summary": "challenge complete",
        "issues": { "$ref": "survivors" },
        "dropped": { "$ref": "dropped" }
      }
    }
  ]
}
